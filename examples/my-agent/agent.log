    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "result": None, "error": f"计算失败：{exc}"}


# ---- 文件读取（限定工作目录） -------------------------------------------
def read_file(rel_path: str, max_bytes: int = 8000):
