        text = text[:max_bytes] + "\n...（已截断）"
    return {"ok": True, "result": text, "error": None}


# ---- 时间 ----------------------------------------------------------------
def now():
    """返回当前日期时间字符串。"""
    return {"ok": True, "result": datetime.now().strftime("%Y-%m-%d %H:%M:%S"), "error": None}


